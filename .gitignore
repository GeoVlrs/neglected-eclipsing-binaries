# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data products: large or private (bundles + FITS light curves)
*.phoebe
*.fits

# CSVs: ignore by default, allow only the small publishable tables
*.csv
!tominima_*.csv
!neglected_targets*.csv
!triage_*.csv

# Per-target MCMC results stay PRIVATE (unpublished thesis data)
results_*.csv

# Logs & notes: publish curated docs only
*.txt
!Expansion_Notes.txt
!docs/*.txt

# Running internal log stays PRIVATE
Pipeline_Log.txt

# Environments
env/
venv/
.env

# Plot output
plots/

# Office documents are not part of the code release
*.docx
